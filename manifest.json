{
  "manifest_version": 3,
  "name": "Page Blocker",
  "version": "1.0",
  "description": "Block URLs and display a sad face when blocked links are opened",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Page Blocker"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
